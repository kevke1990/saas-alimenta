NODE_ENV="development"
DATABASE_URL="postgresql://ka_app:CHANGE-ME@localhost:5432/kinderalimentatie?schema=public"
POSTGRES_PASSWORD="GENERATE-A-LONG-RANDOM-PASSWORD"
SESSION_SECRET="GENERATE-A-LONG-RANDOM-SECRET"
APP_ENCRYPTION_KEY="GENERATE-A-LONG-RANDOM-SECRET"
APP_URL="http://localhost:3000"
ADMIN_PATH="beheer-CHANGE-ME"
ADMIN_EMAIL="admin@example.nl"
ADMIN_PASSWORD="USE-A-LONG-UNIQUE-PASSWORD"
TRUSTED_PROXY_IPS="127.0.0.1"

# Optional Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Branding
BRANDING_MAX_LOGO_BYTES=5242880
BRANDING_ALLOWED_IMAGE_TYPES="image/png,image/jpeg,image/webp,image/svg+xml"

# Custom domains / Cloudflare
APP_BASE_DOMAIN="localhost"
CUSTOM_DOMAIN_MODE="proxy"
CUSTOM_DOMAIN_REQUIRE_VERIFICATION="true"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_SAAS_CNAME_TARGET=""

# Mail
MAIL_PROVIDER="postmark"
POSTMARK_SERVER_TOKEN=""
POSTMARK_ACCOUNT_TOKEN=""
POSTMARK_OUTBOUND_STREAM="outbound"
MAIL_ENCRYPTION_KEY=""
POSTMARK_INBOUND_SECRET="CHANGE-ME-LONG-RANDOM-SECRET"
INBOUND_DOMAIN="inbound.postmarkapp.com"

# AI / privacy
GOOGLE_AI_API_KEY=""
GOOGLE_AI_MODEL="gemini-2.5-flash"
GEMINI_STATELESS=true
AI_PROCESSING_DISABLED=true
PRIVACY_HASH_SALT="change-this-to-a-long-random-secret"

# Demo / release
DEMO_MODE=false
ALIMENTA_IMAGE_TAG="1.3.1-rc1"
